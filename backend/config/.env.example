# LLM API configuration
LLM_API_KEY="replace_with_your_key"
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-v4-flash"

# API server configuration
API_HOST=0.0.0.0
API_PORT=8000

# PaddleOCR-VL queue-worker parser defaults
PADDLEOCR_EXEC_MODE=queue-worker
PADDLEOCR_TASK_QUEUE_URL=redis://redis:6379/0
PADDLEOCR_TASK_QUEUE_NAME=paddleocr:parse
PADDLEOCR_VL_TIMEOUT=14400
PADDLEOCR_PAGE_BATCH_SIZE=7

# Backend model lifecycle
BACKEND_MODEL_LAZY_LOAD=true
BACKEND_UNLOAD_AFTER_TASK=true
