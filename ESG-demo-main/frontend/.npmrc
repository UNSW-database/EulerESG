# Primary registry. npm supports only one active default registry; ordered
# fallback registries are handled by scripts/npm-ci-with-registry-fallback.sh.
registry=https://registry.npmjs.org/
fetch-retries=2
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=120000
prefer-offline=true
fund=false
audit=false
